# Servidor
PORT=3001
NODE_ENV=development
APP_ORIGIN=http://localhost:5173

# Base de datos (PostgreSQL de docker compose)
DATABASE_URL=postgres://archivero:archivero@localhost:5432/archivero

# Sesión
JWT_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres
SESSION_TTL_HOURS=8
# Déjalo vacío con HTTPS; en Docker local sobre HTTP usa false.
# SESSION_COOKIE_SECURE=false

# Almacenamiento compatible con S3 (SeaweedFS en local, Cloudflare R2 en la demo)
S3_ENDPOINT=http://localhost:8333
# Host alternativo para las URLs firmadas que consume el navegador.
# S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=archivero
S3_ACCESS_KEY_ID=archivero
S3_SECRET_ACCESS_KEY=archivero-secret
S3_FORCE_PATH_STYLE=true

# Límites
MAX_FILE_SIZE_MB=25

# Limpieza de subidas pendientes (solo para la ruta de mantenimiento)
MAINTENANCE_SECRET=cambia-esto-tambien
