{
  "name": "@archivero/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx seed.ts",
    "storage:init": "tsx scripts/init-storage.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/s3-request-presigner": "^3.1160.0",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "@node-rs/argon2": "^2.2.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "pdf-lib": "^1.17.1",
    "pngjs": "^7.0.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pngjs": "^6.0.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
